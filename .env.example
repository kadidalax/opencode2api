# API password (required for VPS, recommended for local)
API_KEY=your-password-here

# HTTP proxy (optional, needed in China to bypass region restriction)
# Leave empty on VPS outside China
HTTP_PROXY=http://127.0.0.1:10808

# Default model (optional, auto-detects free models if not set)
#DEFAULT_MODEL=muse-spark-1.3-contributor-free
